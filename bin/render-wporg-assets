#!/usr/bin/env node
// Renders the WordPress.org listing artwork from .wordpress-org/src/*.html
// into the sizes the plugin directory expects:
//
//   bin/render-wporg-assets     -> .wordpress-org/icon-*.png, banner-*.png
//
// Uses the Playwright Chromium installed for the browser tests
// (pnpm exec playwright install chromium).
import { resolve, dirname } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import { chromium } from 'playwright';

const dir = resolve(dirname(fileURLToPath(import.meta.url)), '../.wordpress-org');
const renders = [
	// [source, CSS width, CSS height, scale, output]
	['icon.html', 128, 128, 1, 'icon-128x128.png'],
	['icon.html', 128, 128, 2, 'icon-256x256.png'],
	['banner.html', 772, 250, 1, 'banner-772x250.png'],
	['banner.html', 772, 250, 2, 'banner-1544x500.png'],
];

const browser = await chromium.launch();
try {
	for (const [source, width, height, scale, output] of renders) {
		const page = await browser.newPage({ viewport: { width, height }, deviceScaleFactor: scale });
		await page.goto(pathToFileURL(resolve(dir, 'src', source)).href);
		await page.evaluate(() => document.fonts.ready);
		await page.screenshot({ path: resolve(dir, output) });
		await page.close();
		console.log(`.wordpress-org/${output}`);
	}
} finally {
	await browser.close();
}
